# Copy variables into the process environment before starting JARVIS.
# JARVIS does not load this file automatically.

JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=text
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_WORKSPACE_ROOT=workspace
JARVIS_DATA_DIR=memory
JARVIS_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# JARVIS_CONFIG=configs/development/jarvis.toml
