# Copy variables into the process environment before starting OMNE.
# OMNE does not load this file automatically.

OMNE_ENVIRONMENT=development
OMNE_LOG_LEVEL=INFO
OMNE_LOG_FORMAT=text
OMNE_HOST=127.0.0.1
OMNE_PORT=8787
OMNE_WORKSPACE_ROOT=workspace
OMNE_DATA_DIR=memory
OMNE_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
OMNE_MAX_PARALLEL_TASKS=2
OMNE_TASK_RETRY_LIMIT=2
OMNE_TOOL_TIMEOUT_SECONDS=15
OMNE_XAI_BASE_URL=https://api.x.ai/v1
OMNE_XAI_MODEL=grok-4
OMNE_XAI_TIMEOUT_SECONDS=30
OMNE_XAI_MAX_RETRIES=2
OMNE_LOCAL_MODEL_BASE_URL=
OMNE_BROWSER_COMMAND=
OMNE_AGENTS_DIR=agents
OMNE_MODELS_DIR=models/manifests
OMNE_EXECUTION_MODE=development
OMNE_WORLD_STATE_TTL_SECONDS=5
OMNE_CONTEXT_ITEM_LIMIT=8
OMNE_CONTEXT_CHAR_LIMIT=4000
OMNE_MEMORY_RETRIEVE_LIMIT=20
OMNE_CACHE_TTL_SECONDS=0
OMNE_VERIFICATION_REQUIRED=true
OMNE_ACTIVATION_SHORTCUT=
OMNE_CANCEL_SHORTCUT=
OMNE_PUSH_TO_TALK_SHORTCUT=
# XAI_API_KEY is read only by the xAI provider. OMNE does not load this file.
# XAI_API_KEY=
# OMNE_CONFIG=configs/development/OMNE.toml
