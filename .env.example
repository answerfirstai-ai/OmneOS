# Copy variables into the process environment before starting JARVIS.
# JARVIS does not load this file automatically.

JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=text
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_WORKSPACE_ROOT=workspace
JARVIS_DATA_DIR=memory
JARVIS_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
JARVIS_MAX_PARALLEL_TASKS=2
JARVIS_TASK_RETRY_LIMIT=2
JARVIS_TOOL_TIMEOUT_SECONDS=15
JARVIS_XAI_BASE_URL=https://api.x.ai/v1
JARVIS_XAI_MODEL=grok-4
JARVIS_XAI_TIMEOUT_SECONDS=30
JARVIS_XAI_MAX_RETRIES=2
JARVIS_LOCAL_MODEL_BASE_URL=
JARVIS_BROWSER_COMMAND=
JARVIS_AGENTS_DIR=agents
JARVIS_MODELS_DIR=models/manifests
# XAI_API_KEY is read only by the xAI provider. JARVIS does not load this file.
# XAI_API_KEY=
# JARVIS_CONFIG=configs/development/jarvis.toml
