{
  "name": "OMNE-os",
  "version": "0.1.0",
  "private": true,
  "description": "OMNE OS shell foundation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p shell/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "tsc -p shell/tsconfig.test.json && node --test shell/dist-test/**/*.test.js",
    "typecheck": "tsc -p shell/tsconfig.json --noEmit && tsc -p shell/tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
