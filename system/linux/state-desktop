#!/bin/sh
# After the password unlock, start the existing OMNE session.
# labwc is the compositor. The shell is the existing page on port 4173.
# This initramfs is not systemd. A full rootfs still uses omne-session.service.
export PATH="/usr/sbin:/usr/bin:/bin:/sbin"
export LD_LIBRARY_PATH="/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export HOME="/tmp/omne-home"
export XDG_RUNTIME_DIR="/run/omne"
export XKB_CONFIG_ROOT="/usr/share/X11/xkb"
export WLR_RENDERER="${WLR_RENDERER:-pixman}"
# virtio-vga has no virgl here. cog paints through llvmpipe shared-memory buffers.
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"
export COG_PLATFORM_WL_VIEW_FULLSCREEN="${COG_PLATFORM_WL_VIEW_FULLSCREEN:-1}"
export FONTCONFIG_PATH="${FONTCONFIG_PATH:-/etc/fonts}"
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS="${WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS:-1}"
export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-seatd}"

/bin/busybox mkdir -p /run /tmp/omne-home /run/omne /dev/shm /dev/dri
if ! /bin/busybox grep -q " /run " /proc/mounts; then
  /bin/busybox mount -t tmpfs -o mode=755 tmpfs /run
fi
/bin/busybox mkdir -p /run/omne
/bin/busybox chmod 700 /run/omne /tmp/omne-home
if ! /bin/busybox grep -q " /dev/shm " /proc/mounts; then
  /bin/busybox mount -t tmpfs -o mode=1777 tmpfs /dev/shm || true
fi

if [ -f /etc/omne/modules.desktop ]; then
  while IFS= read -r module; do
    if [ -n "${module}" ]; then
      /bin/busybox insmod "${module}" 2>/dev/null || true
    fi
  done < /etc/omne/modules.desktop
fi

waited=0
while [ "${waited}" -lt 15 ]; do
  if /bin/busybox ls /dev/dri/card* >/dev/null 2>&1; then
    break
  fi
  waited=$((waited + 1))
  /bin/busybox sleep 1
done

chosen=""
virtio=""
for node in /dev/dri/card*; do
  if [ ! -e "${node}" ]; then
    continue
  fi
  name="${node##*/}"
  driver=""
  if [ -L "/sys/class/drm/${name}/device/driver" ]; then
    driver="$(/bin/busybox readlink "/sys/class/drm/${name}/device/driver")"
  fi
  case "${driver}" in
    *virtio*) virtio="${node}" ;;
  esac
  if [ -z "${chosen}" ]; then
    chosen="${node}"
  fi
done
if [ -n "${virtio}" ]; then
  chosen="${virtio}"
fi
if [ -z "${chosen}" ]; then
  echo "OMNE desktop: no DRM device" >&2
  exit 1
fi
export WLR_DRM_DEVICES="${chosen}"
echo "OMNE desktop DRM ${chosen}"

/bin/busybox ip link set lo up || {
  echo "OMNE shell: loopback did not start" >&2
  exit 1
}

# Same program and settings as omne-core.service. This initramfs is not systemd.
if [ ! -x /usr/bin/OMNE ] || [ ! -f /etc/omne/OMNE.toml ]; then
  echo "OMNE core missing" >&2
  exit 1
fi
if /bin/busybox grep -q " /var/lib/omne " /proc/mounts; then
  /bin/busybox mount -o remount,rw /var/lib/omne || {
    echo "OMNE core: state is not writable" >&2
    exit 1
  }
fi
/bin/busybox mkdir -p /var/lib/omne/workspace /var/lib/omne/memory
(
  cd /var/lib/omne || exit 1
  OMNE_ENVIRONMENT=production OMNE_CONFIG=/etc/omne/OMNE.toml /usr/bin/OMNE serve
) >/tmp/omne-core.log 2>&1 &
core_pid=$!
ready=0
tries=0
while [ "${tries}" -lt 40 ]; do
  if /usr/bin/python3 -c 'import json, urllib.request
try:
    health = json.load(urllib.request.urlopen("http://127.0.0.1:8787/health", timeout=2))
    intel = json.load(urllib.request.urlopen("http://127.0.0.1:8787/intelligence", timeout=2))
except Exception:
    raise SystemExit(1)
ok = health.get("status") == "ok" and health.get("service") == "OMNE-core"
off = intel.get("enabled") is False and intel.get("desktop") is True
raise SystemExit(0 if ok and off else 1)' >/dev/null 2>&1; then
    ready=1
    break
  fi
  if ! /bin/busybox kill -0 "${core_pid}" 2>/dev/null; then
    break
  fi
  tries=$((tries + 1))
  /bin/busybox sleep 1
done
if [ "${ready}" -ne 1 ]; then
  echo "OMNE core did not answer" >&2
  /bin/busybox cat /tmp/omne-core.log >&2 || true
  exit 1
fi
echo "OMNE core up"
echo "OMNE intelligence off"

if [ ! -f /usr/share/omne/shell/index.html ]; then
  echo "OMNE shell missing" >&2
  exit 1
fi
if [ ! -x /usr/bin/labwc ] || [ ! -x /usr/bin/seatd-launch ]; then
  echo "labwc missing" >&2
  exit 1
fi

/usr/bin/python3 -m http.server --directory /usr/share/omne/shell --bind 127.0.0.1 4173 >/tmp/omne-shell.log 2>&1 &

ready=0
tries=0
while [ "${tries}" -lt 25 ]; do
  if /usr/bin/python3 -c 'import urllib.request
try:
    body = urllib.request.urlopen("http://127.0.0.1:4173/", timeout=2).read().decode("utf-8", "replace")
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if "id=\"desktop\"" in body else 1)' >/dev/null 2>&1; then
    ready=1
    break
  fi
  tries=$((tries + 1))
  /bin/busybox sleep 1
done
if [ "${ready}" -ne 1 ]; then
  echo "OMNE shell did not answer" >&2
  /bin/busybox cat /tmp/omne-shell.log >&2 || true
  exit 1
fi
echo "OMNE shell up"

echo "starting labwc"
exec /usr/bin/seatd-launch /usr/bin/python3 /usr/bin/omne-session
