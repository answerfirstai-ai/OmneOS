#!/usr/bin/env python3
"""Print boot diagnostics for the VM serial log.

The sections are reads: unit state, the journal, and GET /health. This program
does not start a compositor, launch an application, enter recovery, or touch a
disk.
"""

from __future__ import annotations

import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path


def main() -> int:
    sections = (
        ("services", _services),
        ("core", _core),
        ("ipc", _ipc),
        ("display", _display),
        ("shell", _shell),
        ("applications", lambda: "application_launch=not_run\n"),
        ("agents", lambda: "agent_task=not_run\n"),
        ("models", _models),
        ("recovery", _recovery),
    )
    for name, reader in sections:
        sys.stdout.write(f"@@omne-diag {name}@@\n")
        try:
            sys.stdout.write(reader())
        except OSError as exc:
            sys.stdout.write(f"diag_error={type(exc).__name__}: {exc}\n")
        sys.stdout.write(f"@@omne-diag end {name}@@\n")
        sys.stdout.flush()
    return 0


def _services() -> str:
    units = [
        "omne-core.service",
        "omne-shell.service",
        "omne-boot.service",
        "omne-diag.service",
        "omne-session.service",
    ]
    shown = _command(
        [
            "systemctl",
            "show",
            *units,
            "-p",
            "Id",
            "-p",
            "ActiveState",
            "-p",
            "Result",
            "-p",
            "ExecMainStatus",
        ]
    )
    status = _command(["systemctl", "status", *units, "--no-pager", "--lines=20"])
    return shown + status


def _core() -> str:
    return _command(["journalctl", "-u", "omne-core.service", "-n", "80", "--no-pager"])


def _ipc() -> str:
    url = "http://127.0.0.1:8787/health"
    request = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=3) as response:
            body = response.read().decode("utf-8", errors="replace")
            status = getattr(response, "status", 200)
    except (OSError, urllib.error.URLError, UnicodeError, ValueError) as exc:
        return f"health_error={type(exc).__name__}: {exc}\n"
    return f"http_status={status}\n{body}\n"


def _display() -> str:
    names: list[str] = []
    for directory in (Path("/sys/class/drm"), Path("/dev/dri"), Path("/dev/input")):
        try:
            found = sorted(path.name for path in directory.iterdir()) if directory.is_dir() else []
        except OSError:
            found = ["unreadable"]
        names.append(f"{directory}={' '.join(found) if found else 'absent'}")
    drm = Path("/sys/class/drm")
    if drm.is_dir():
        for path in sorted(drm.iterdir()):
            status = _read_text(path / "status")
            enabled = _read_text(path / "enabled")
            if status or enabled:
                names.append(
                    f"{path.name} status={status or 'absent'} enabled={enabled or 'absent'}"
                )
    names.append(
        _command(["systemctl", "status", "omne-session.service", "--no-pager", "--lines=40"])
    )
    return "\n".join(names) + "\n"


def _read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def _shell() -> str:
    state = _command(
        ["systemctl", "show", "omne-shell.service", "-p", "ActiveState", "-p", "Result"]
    )
    url = "http://127.0.0.1:4173/"
    request = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=3) as response:
            body = response.read().decode("utf-8", errors="replace")
            status = getattr(response, "status", 200)
    except (OSError, urllib.error.URLError, UnicodeError, ValueError) as exc:
        return state + f"shell_http_error={type(exc).__name__}: {exc}\n"
    marker = "yes" if 'id="desktop"' in body else "no"
    return state + f"shell_http={status} desktop_marker={marker}\n"


def _models() -> str:
    return _command(["/usr/bin/OMNE", "models"])


def _recovery() -> str:
    return _command(["/usr/bin/OMNE", "recover", "status"])


def _command(argv: list[str]) -> str:
    try:
        completed = subprocess.run(
            argv,
            check=False,
            capture_output=True,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return f"command_error={type(exc).__name__}: {exc}\n"
    text = completed.stdout
    if completed.stderr:
        text += completed.stderr
    if not text.endswith("\n"):
        text += "\n"
    return text


if __name__ == "__main__":
    raise SystemExit(main())
