#!/usr/bin/env python3
"""OMNE login. systemd starts this. A person does not."""

from __future__ import annotations

import sys
from pathlib import Path

_SITE = Path("/usr/lib/omne/python")
if _SITE.is_dir():
    sys.path.insert(0, str(_SITE))

from omne.login import login_main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(login_main())
