[Unit]
Description=OMNE boot diagnostics
After=omne-core.service omne-shell.service omne-boot.service
Wants=omne-core.service

[Service]
Type=oneshot
Environment=OMNE_ENVIRONMENT=production
Environment=OMNE_CONFIG=/etc/omne/OMNE.toml
ExecStart=/usr/bin/omne-diag
StandardOutput=journal+console
StandardError=journal+console
Restart=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
InaccessiblePaths=/boot /efi /etc/shadow /etc/gshadow /etc/sudoers /etc/ssh

[Install]
WantedBy=omne.target
