[Unit]
Description=OMNE boot diagnostics
After=multi-user.target omne-boot.service
Wants=omne-core.service

[Service]
Type=oneshot
Environment=OMNE_ENVIRONMENT=production
Environment=OMNE_CONFIG=/etc/omne/OMNE.toml
ExecStart=/usr/bin/omne-diag
StandardOutput=journal+console
StandardError=journal+console
Restart=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# A leading '-' skips a path that is not on this image. /efi is absent on the live ISO.
InaccessiblePaths=-/boot -/efi -/etc/shadow -/etc/gshadow -/etc/sudoers -/etc/ssh

[Install]
WantedBy=multi-user.target
